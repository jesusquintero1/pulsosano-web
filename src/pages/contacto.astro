---
import Base from '../layouts/Base.astro';
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || '';
---
<Base title="Contacto — PulsoSano"
      description="Escríbenos para correcciones editoriales, sugerencias o asuntos legales relacionados con PulsoSano.">
  <section class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-3xl md:text-4xl font-bold text-ink-900">Contacto</h1>
    <p class="mt-3 text-ink-700">
      ¿Detectaste un error en un artículo, quieres sugerir un tema o necesitas
      contactarnos por motivos legales? Usa este formulario y te responderemos en
      un plazo razonable.
    </p>

    <div class="mt-6 p-5 border-l-4 border-brand-500 bg-brand-50 rounded-r-lg text-sm text-ink-700">
      <strong class="text-ink-900">No prestamos servicios médicos.</strong>
      Si necesitas atención sanitaria, acude a un profesional o, en caso de
      emergencia, comunícate con los servicios de urgencia de tu país.
    </div>

    <form action={endpoint || '#'} method="POST" class="mt-8 space-y-4">
      <div>
        <label for="nombre" class="block text-sm font-medium text-ink-900 mb-1">Nombre</label>
        <input type="text" id="nombre" name="nombre" required
          class="w-full px-3 py-2 border border-ink-200 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-ink-900 mb-1">Correo electrónico</label>
        <input type="email" id="email" name="email" required
          class="w-full px-3 py-2 border border-ink-200 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <label for="asunto" class="block text-sm font-medium text-ink-900 mb-1">Asunto</label>
        <select id="asunto" name="asunto" class="w-full px-3 py-2 border border-ink-200 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option>Corrección editorial</option>
          <option>Sugerencia de tema</option>
          <option>Asunto legal / privacidad</option>
          <option>Publicidad</option>
          <option>Otro</option>
        </select>
      </div>
      <div>
        <label for="mensaje" class="block text-sm font-medium text-ink-900 mb-1">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="5" required
          class="w-full px-3 py-2 border border-ink-200 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
      </div>
      <button type="submit" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-medium rounded-md transition">
        Enviar mensaje
      </button>
      {!endpoint && (
        <p class="text-xs text-ink-500">
          (Configura <code>PUBLIC_NEWSLETTER_ENDPOINT</code> con tu endpoint de Formspree para activar el formulario.)
        </p>
      )}
    </form>
  </section>
</Base>
