---
import Base from '../layouts/Base.astro';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto — PulsoSano',
  url: 'https://pulsosano.com/contacto/',
  mainEntity: {
    '@type': 'NewsMediaOrganization',
    name: 'PulsoSano',
    email: 'contacto@pulsosano.com',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'editorial',
        email: 'contacto@pulsosano.com',
        availableLanguage: ['Spanish'],
      },
      {
        '@type': 'ContactPoint',
        contactType: 'corrections',
        email: 'contacto@pulsosano.com',
        availableLanguage: ['Spanish'],
      },
      {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'contacto@pulsosano.com',
        availableLanguage: ['Spanish'],
      },
    ],
  },
};
---
<Base title="Contacto — PulsoSano"
      description="Contacta al equipo editorial de PulsoSano: correcciones, sugerencias, asuntos legales y consultas profesionales. Respuesta en máximo 5 días hábiles.">

  <script type="application/ld+json" set:html={JSON.stringify(contactLd)} />

  <section class="max-w-2xl mx-auto px-4 py-10">
    <nav class="text-sm text-ink-500 mb-4" aria-label="breadcrumb">
      <a href="/" class="hover:text-brand-600">Inicio</a> <span class="mx-1">/</span> Contacto
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold text-ink-900">Contacto</h1>
    <p class="mt-3 text-ink-700">
      Escríbenos para reportar errores, sugerir temas o cualquier consulta editorial,
      legal o profesional. Respondemos a las correcciones en un plazo máximo de
      <strong>5 días hábiles</strong>.
    </p>

    <div class="mt-6 p-5 border-l-4 border-brand-500 bg-brand-50 rounded-r-lg text-sm text-ink-700">
      <strong class="text-ink-900">No prestamos servicios médicos.</strong>
      Si necesitas atención sanitaria, acude a un profesional o, en caso de
      emergencia, comunícate con los servicios de urgencia de tu país.
    </div>

    <h2 class="mt-8 text-xl font-semibold text-ink-900">Cómo escribirnos</h2>
    <p class="mt-2 text-sm text-ink-600">
      Un solo buzón atiende todos los asuntos. Para que lleguemos antes a tu mensaje,
      empieza el asunto con la etiqueta que corresponda:
    </p>

    <div class="mt-4 overflow-hidden border border-ink-200 rounded-lg">
      <table class="w-full text-sm">
        <thead class="bg-ink-100">
          <tr>
            <th class="px-4 py-2 text-left font-semibold text-ink-900">Asunto</th>
            <th class="px-4 py-2 text-left font-semibold text-ink-900">Etiqueta en el asunto</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100">
          <tr><td class="px-4 py-2.5 text-ink-700">Corrección de contenido</td><td class="px-4 py-2.5 font-mono text-xs">[CORRECCIÓN]</td></tr>
          <tr><td class="px-4 py-2.5 text-ink-700">Sugerencia de tema o fuente</td><td class="px-4 py-2.5 font-mono text-xs">[SUGERENCIA]</td></tr>
          <tr><td class="px-4 py-2.5 text-ink-700">Privacidad / asuntos legales</td><td class="px-4 py-2.5 font-mono text-xs">[PRIVACIDAD]</td></tr>
          <tr><td class="px-4 py-2.5 text-ink-700">Publicidad / patrocinio de newsletter</td><td class="px-4 py-2.5 font-mono text-xs">[PUBLICIDAD]</td></tr>
          <tr><td class="px-4 py-2.5 text-ink-700">Consulta profesional o institucional</td><td class="px-4 py-2.5 font-mono text-xs">[EDITORIAL]</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-3">
      <a href="mailto:contacto@pulsosano.com?subject=%5BCORRECCI%C3%93N%5D%20"
         class="inline-flex justify-center px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-medium rounded-md transition">
        Escribir a contacto@pulsosano.com
      </a>
      <span class="text-sm text-ink-600">o copia la dirección: <strong class="text-ink-900 select-all">contacto@pulsosano.com</strong></span>
    </div>

    <p class="mt-8 text-xs text-ink-500">
      Tiempos de respuesta: <strong>correcciones</strong> hasta 5 días hábiles ·
      <strong>consultas generales</strong> hasta 10 días hábiles · <strong>asuntos legales</strong> según corresponda.
    </p>
  </section>
</Base>
