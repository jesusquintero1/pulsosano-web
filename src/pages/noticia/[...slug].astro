---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { AD_SLOTS } from '../../adSlots';

export async function getStaticPaths() {
  const todas = await getCollection('noticias');
  return todas.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, todas },
  }));
}

const { entry, todas } = Astro.props as any;
const { Content } = await entry.render();
const d = entry.data;

function slugCat(c: string) {
  return c
    .toLowerCase()
    .replace(/[áéíóúñ]/g, (ch: string) => ({ á:'a', é:'e', í:'i', ó:'o', ú:'u', ñ:'n' } as any)[ch] || ch)
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

const SITE_URL = (import.meta.env.SITE_URL || 'https://pulsosano.com').replace(/\/$/, '');
const url = SITE_URL + '/noticia/' + entry.slug + '/';
const catSlug = slugCat(d.categoria);

const fechaTxt = new Date(d.fecha).toLocaleDateString('es', { year: 'numeric', month: 'long', day: 'numeric' });
const fechaIso = new Date(d.fecha).toISOString();

const ts = (n: any) => new Date(n.data.fecha).getTime();

// Misma categoría (recirculación principal) — 6 para más enlaces internos.
const relacionadas = todas
  .filter((n: any) => n.slug !== entry.slug && n.data.categoria === d.categoria)
  .sort((a: any, b: any) => ts(b) - ts(a))
  .slice(0, 6);

// Relacionadas por TAG en OTRAS categorías: teje el grafo interno cruzado,
// reparte PageRank y abre rutas de navegación que suben páginas/sesión.
const tagSet = new Set((d.tags || []).map((t: string) => t.toLowerCase()));
const yaListadas = new Set(relacionadas.map((n: any) => n.slug));
const porTags = tagSet.size === 0 ? [] : todas
  .filter((n: any) =>
    n.slug !== entry.slug &&
    !yaListadas.has(n.slug) &&
    n.data.categoria !== d.categoria &&
    (n.data.tags || []).some((t: string) => tagSet.has(t.toLowerCase())))
  .sort((a: any, b: any) => ts(b) - ts(a))
  .slice(0, 4);

// Lo más reciente del sitio (aside) — recirculación adicional y frescura.
const recientes = todas
  .filter((n: any) => n.slug !== entry.slug)
  .sort((a: any, b: any) => ts(b) - ts(a))
  .slice(0, 5);

// SEO: FAQ y entidades (campos opcionales; los artículos históricos no los traen).
const faqs = (d.faqs || []) as { pregunta: string; respuesta: string }[];
const entidades = (d.entidades || []) as { nombre: string; tipo?: string; wikipedia?: string }[];

// Tiempo de lectura estimado: ~225 palabras por minuto (es).
const bodyText: string = (entry.body || '') as string;
const wordCount = bodyText.split(/\s+/).filter(Boolean).length;
const readingMin = Math.max(2, Math.round(wordCount / 225));

const tipoEvidencia = (() => {
  const c = d.categoria;
  if (c === 'Investigación Clínica') return 'Estudio académico / ensayo';
  if (c === 'Avances Médicos') return 'Novedad clínica / regulatoria';
  if (c === 'Medicina Preventiva') return 'Recomendación preventiva';
  if (c === 'Salud Pública y Política') return 'Política sanitaria / OMS';
  return 'Divulgación informativa';
})();

// Schema híbrido: NewsArticle (para Google Discover / Top Stories) +
// MedicalScholarlyArticle según la categoría.
const isResearch = d.categoria === 'Investigación Clínica' || d.categoria === 'Avances Médicos';
const articleType = isResearch ? ['NewsArticle', 'MedicalScholarlyArticle'] : 'NewsArticle';

// TOC: extraer H2 del markdown para anchors visibles en SERP de Google.
const h2Regex = /^##\s+(.+?)\s*$/gm;
const tocItems: { text: string; slug: string }[] = [];
let m: RegExpExecArray | null;
while ((m = h2Regex.exec(bodyText)) !== null) {
  const t = m[1].replace(/[#*_`]/g, '').trim();
  const s = t.toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  if (s) tocItems.push({ text: t, slug: s });
}

const articleLd = {
  '@context': 'https://schema.org',
  '@type': articleType,
  headline: d.titulo.slice(0, 110), // Google News exige ≤ 110 caracteres
  alternativeHeadline: d.resumen.slice(0, 160),
  description: d.resumen,
  inLanguage: 'es',
  isAccessibleForFree: true,
  datePublished: fechaIso,
  dateModified: fechaIso,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: {
    '@type': 'ImageObject',
    url: d.imagen || (SITE_URL + '/og-default.png'),
    width: 1200,
    height: 630,
  },
  author: [{
    '@type': 'Organization',
    name: 'Comité Editorial PulsoSano',
    url: SITE_URL + '/equipo-editorial',
  }],
  // E-E-A-T: revisión editorial humana sobre el borrador asistido por IA.
  reviewedBy: {
    '@type': 'Organization',
    name: 'Comité Editorial PulsoSano',
    url: SITE_URL + '/equipo-editorial',
  },
  publisher: {
    '@type': 'NewsMediaOrganization',
    name: 'PulsoSano',
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: SITE_URL + '/og-default.png', width: 1200, height: 630 },
    publishingPrinciples: SITE_URL + '/metodologia',
    ethicsPolicy: SITE_URL + '/metodologia#etica',
    correctionsPolicy: SITE_URL + '/metodologia#correcciones',
    diversityPolicy: SITE_URL + '/metodologia#diversidad',
  },
  citation: {
    '@type': 'CreativeWork',
    name: d.fuente.nombre,
    url: d.fuente.url,
  },
  isBasedOn: d.fuente.url,
  keywords: (d.tags || []).join(', '),
  articleSection: d.categoria,
  wordCount: wordCount,
  // about/mentions: entidades médicas con sameAs a Wikipedia → Knowledge Graph.
  // Si no hay entidades (artículos históricos), cae al comportamiento previo.
  about: entidades.length > 0
    ? entidades.map((e) => ({
        '@type': e.tipo || (isResearch ? 'MedicalCondition' : 'Thing'),
        name: e.nombre,
        ...(e.wikipedia ? { sameAs: e.wikipedia } : {}),
      }))
    : (isResearch
        ? { '@type': 'MedicalCondition', name: d.categoria }
        : { '@type': 'Thing', name: d.categoria }),
  // Speakable: indica a asistentes de voz qué partes leer.
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'header p', '.prose-medical p:first-of-type'],
  },
};

// FAQPage: captura "Otras preguntas" y rich results en el SERP. Solo si hay FAQs.
const faqLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
} : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: d.categoria, item: SITE_URL + '/categoria/' + catSlug + '/' },
    { '@type': 'ListItem', position: 3, name: d.titulo, item: url },
  ],
};

const shareText = encodeURIComponent(d.titulo + ' — PulsoSano');
const shareUrl = encodeURIComponent(url);
---
<Base
  title={d.titulo.length > 60 ? d.titulo : d.titulo + ' — PulsoSano'}
  description={d.resumen}
  image={d.imagen}
  canonical={url}
  noindex={d.noindex === true}
  type="article"
  jsonLd={faqLd ? [articleLd, breadcrumbLd, faqLd] : [articleLd, breadcrumbLd]}
  publishedTime={fechaIso}
  modifiedTime={fechaIso}
  articleSection={d.categoria}
  articleTags={d.tags || []}
>
  <article class="max-w-6xl mx-auto px-4 py-8">

    <nav class="text-sm text-ink-500 mb-4" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-brand-700">Inicio</a>
      <span class="mx-2">/</span>
      <a href={'/categoria/' + catSlug + '/'} class="hover:text-brand-700">{d.categoria}</a>
      <span class="mx-2">/</span>
      <span class="text-ink-700">{d.titulo}</span>
    </nav>

    <header class="mb-8 max-w-4xl">
      <div class="flex flex-wrap items-center gap-2 text-xs mb-3">
        <a href={'/categoria/' + catSlug + '/'} class="inline-flex px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 font-medium hover:bg-brand-100">{d.categoria}</a>
        <span class="text-ink-500">Publicado el <time datetime={fechaIso}>{fechaTxt}</time></span>
        <span class="text-ink-300">·</span>
        <span class="text-ink-500">{readingMin} min de lectura</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-ink-900 leading-[1.1] tracking-tight" style="font-family:'Source Serif Pro', ui-serif, Georgia, serif;">{d.titulo}</h1>
      <p class="mt-5 text-lg md:text-xl text-ink-700 leading-relaxed max-w-3xl" style="font-family:'Source Serif Pro', ui-serif, Georgia, serif;">{d.resumen}</p>

      <!-- Byline E-E-A-T: autoría editorial + revisión humana, enlazadas a las páginas de transparencia. -->
      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-600 border-t border-ink-100 pt-4 max-w-3xl">
        <span>
          Por <a href="/equipo-editorial" rel="author" class="font-semibold text-ink-900 underline-offset-2 hover:text-brand-700 hover:underline">Comité Editorial PulsoSano</a>
        </span>
        <span class="text-ink-300" aria-hidden="true">·</span>
        <span>
          Revisado según nuestra <a href="/metodologia" class="text-brand-700 underline-offset-2 hover:underline">metodología editorial</a>
        </span>
      </div>
    </header>

    {d.imagen && (
      <figure class="my-8 max-w-5xl">
        <img src={d.imagen} alt={d.titulo}
          width="1200" height="675" loading="eager" decoding="async"
          referrerpolicy="no-referrer"
          class="w-full h-auto rounded-lg border border-ink-100"
          onerror="this.onerror=null;this.src='/og-default.png';" />
      </figure>
    )}

    <div class="grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-12 xl:gap-16">

      <!-- COLUMNA PRINCIPAL -->
      <div>
        <!-- AdSlot top — arriba del fold, formato horizontal -->
        <AdSlot slot={AD_SLOTS.articleTop} variant="horizontal" format="auto" lazy={false} />

        <MedicalDisclaimer variant="box" />

        <div class="prose-medical">
          <Content />
        </div>

        <!-- AdSlot in-article — formato fluido (mejor RPM en mobile) -->
        <AdSlot slot={AD_SLOTS.articleInline} layout="in-article" variant="fluid" format="fluid" lazy={true} />

        {faqs.length > 0 && (
          <section class="mt-12" aria-labelledby="faq-titulo">
            <h2 id="faq-titulo" class="text-2xl font-bold text-ink-900 mb-5" style="font-family:'Source Serif Pro', ui-serif, Georgia, serif;">
              Preguntas frecuentes
            </h2>
            <div class="divide-y divide-ink-100 border-y border-ink-100">
              {faqs.map((f) => (
                <details class="group py-1">
                  <summary class="flex items-start justify-between gap-3 cursor-pointer list-none py-3 font-medium text-ink-900 hover:text-brand-700">
                    <span>{f.pregunta}</span>
                    <span class="text-brand-500 shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                  </summary>
                  <p class="pb-4 text-ink-700 leading-relaxed">{f.respuesta}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <section class="mt-10 p-5 border border-ink-100 rounded-lg bg-ink-100/40">
          <p class="text-sm text-ink-700">
            <strong class="text-ink-900">Fuente original:</strong>
            <a href={d.fuente.url} target="_blank" rel="nofollow noopener noreferrer" class="text-brand-700 underline ml-1">
              {d.fuente.nombre}
            </a>
          </p>
          <p class="text-xs text-ink-500 mt-2">
            Artículo divulgativo reescrito en español por PulsoSano. Consulta el original
            para detalles técnicos y referencias bibliográficas completas.
          </p>
        </section>

        <section class="mt-8" aria-label="Compartir">
          <p class="text-xs uppercase tracking-widest text-ink-500 mb-2">Compartir</p>
          <div class="flex flex-wrap gap-2">
            <a class="px-3 py-1.5 rounded-md bg-ink-900 text-white text-sm hover:bg-ink-700"
               href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener">X / Twitter</a>
            <a class="px-3 py-1.5 rounded-md bg-blue-700 text-white text-sm hover:bg-blue-800"
               href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener">LinkedIn</a>
            <a class="px-3 py-1.5 rounded-md bg-green-600 text-white text-sm hover:bg-green-700"
               href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </section>

        {(d.tags && d.tags.length > 0) && (
          <section class="mt-6">
            <p class="text-xs uppercase tracking-widest text-ink-500 mb-2">Etiquetas</p>
            <div class="flex flex-wrap gap-2">
              {d.tags.map((t: string) => (
                <span class="px-2 py-0.5 rounded bg-ink-100 text-ink-700 text-xs">#{t}</span>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- ASIDE LATERAL (notas marginales estilo distill.pub) -->
      <aside class="mt-10 lg:mt-0 lg:sticky lg:top-24 lg:self-start space-y-6">

        {tocItems.length > 1 && (
          <section class="marginalia border border-ink-100 rounded-lg p-5 bg-white">
            <p class="marginalia-title">En este artículo</p>
            <ol class="space-y-1 text-sm list-decimal pl-5 marker:text-brand-500">
              {tocItems.map((t) => (
                <li><a href={'#' + t.slug} class="text-ink-700 hover:text-brand-700 hover:underline">{t.text}</a></li>
              ))}
            </ol>
          </section>
        )}

        <!-- TARJETA: Sobre este artículo -->
        <section class="marginalia border border-ink-100 rounded-lg p-5 bg-white">
          <p class="marginalia-title">Sobre este artículo</p>
          <dl class="space-y-2">
            <div>
              <dt class="text-xs text-ink-500">Categoría</dt>
              <dd class="text-ink-900 font-medium">{d.categoria}</dd>
            </div>
            <div>
              <dt class="text-xs text-ink-500">Tipo de contenido</dt>
              <dd class="text-ink-900">{tipoEvidencia}</dd>
            </div>
            <div>
              <dt class="text-xs text-ink-500">Publicado</dt>
              <dd class="text-ink-900"><time datetime={fechaIso}>{fechaTxt}</time></dd>
            </div>
            <div>
              <dt class="text-xs text-ink-500">Lectura estimada</dt>
              <dd class="text-ink-900">{readingMin} min</dd>
            </div>
            <div>
              <dt class="text-xs text-ink-500">Redacción</dt>
              <dd class="text-ink-900">Borrador asistido por IA bajo prompt editorial</dd>
            </div>
            <div>
              <dt class="text-xs text-ink-500">Revisión editorial</dt>
              <dd class="text-ink-900">Comité Editorial PulsoSano</dd>
            </div>
          </dl>
          <a href="/metodologia" class="inline-block mt-3 text-brand-700 text-sm underline underline-offset-2">Cómo trabajamos →</a>
        </section>

        <!-- TARJETA: Fuente original -->
        <section class="marginalia border-l-4 border-brand-500 bg-brand-50/40 rounded-r-lg p-5">
          <p class="marginalia-title">Fuente original</p>
          <p class="font-semibold text-ink-900 mb-1">{d.fuente.nombre}</p>
          <a href={d.fuente.url} target="_blank" rel="nofollow noopener noreferrer" class="text-brand-700 underline text-sm break-words">
            Leer artículo original →
          </a>
          <p class="text-xs text-ink-500 mt-3 leading-relaxed">
            Los hallazgos y cifras corresponden a la fuente. PulsoSano reescribe sin
            copiar texto literal.
          </p>
        </section>

        {d.porQueImporta && (
          <section class="marginalia border-l-4 border-accent-500 bg-accent-500/5 rounded-r-lg p-5">
            <p class="marginalia-title" style="color:#1d4ed8;">Por qué importa</p>
            <p class="text-ink-700">{d.porQueImporta}</p>
          </section>
        )}

        <!-- TARJETA: Aviso médico siempre visible -->
        <section class="marginalia border border-ink-200 rounded-lg p-5 bg-white">
          <p class="marginalia-title">Aviso médico</p>
          <p class="text-ink-700">
            Este contenido es informativo. <strong class="text-ink-900">No sustituye la consulta</strong>
            con un profesional sanitario calificado. Antes de tomar decisiones sobre tu salud,
            consulta con tu médico.
          </p>
          <a href="/aviso-medico" class="inline-block mt-2 text-brand-700 text-sm underline">Más información</a>
        </section>

        {entidades.length > 0 && (
          <section class="marginalia border border-ink-100 rounded-lg p-5 bg-white">
            <p class="marginalia-title">Temas tratados</p>
            <ul class="space-y-1.5 text-sm">
              {entidades.map((e) => (
                <li>
                  {e.wikipedia
                    ? <a href={e.wikipedia} target="_blank" rel="noopener nofollow" class="text-brand-700 hover:underline">{e.nombre}</a>
                    : <span class="text-ink-800">{e.nombre}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {recientes.length > 0 && (
          <section class="marginalia border border-ink-100 rounded-lg p-5 bg-white">
            <p class="marginalia-title">Lo más reciente</p>
            <ul class="space-y-2 text-sm">
              {recientes.map((p: any) => (
                <li>
                  <a href={'/noticia/' + p.slug + '/'} class="text-ink-700 hover:text-brand-700 hover:underline leading-snug block">
                    {p.data.titulo}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- AdSlot vertical 300x600 — visible solo en lg+, sticky -->
        <div class="hidden lg:block">
          <AdSlot slot={AD_SLOTS.articleSidebar} variant="vertical" format="auto" lazy={true} />
        </div>

      </aside>
    </div>
  </article>

  {relacionadas.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 pb-16 mt-12 border-t border-ink-100 pt-12">
      <h2 class="text-2xl font-bold text-ink-900 mb-6">Más en {d.categoria}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {relacionadas.map((p: any) => (
          <ArticleCard
            href={'/noticia/' + p.slug + '/'}
            titulo={p.data.titulo}
            resumen={p.data.resumen}
            categoria={p.data.categoria}
            fecha={p.data.fecha}
            imagen={p.data.imagen}
          />
        ))}
      </div>
    </section>
  )}

  {porTags.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 pb-16 mt-4">
      <h2 class="text-xl font-bold text-ink-900 mb-5">Temas relacionados</h2>
      <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
        {porTags.map((p: any) => (
          <li class="flex items-baseline gap-2">
            <span class="text-brand-500 shrink-0" aria-hidden="true">›</span>
            <a href={'/noticia/' + p.slug + '/'} class="text-ink-700 hover:text-brand-700 hover:underline leading-snug">
              {p.data.titulo}
              <span class="text-ink-400 text-xs ml-1">· {p.data.categoria}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
