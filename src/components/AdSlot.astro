---
export interface Props {
  slot?: string;
  format?: string;
  layout?: 'in-article' | 'display' | 'in-feed';
  variant?: 'horizontal' | 'vertical' | 'square' | 'fluid';
  lazy?: boolean;
  className?: string;
}

const {
  slot = '',
  format = 'auto',
  layout = 'display',
  variant = 'horizontal',
  lazy = false,
  className = '',
} = Astro.props;

const ADSENSE = import.meta.env.PUBLIC_ADSENSE_CLIENT || '';
const active = ADSENSE && !ADSENSE.includes('__PENDIENTE__');

// Slot real = string de dígitos no vacío (el data-ad-slot de 10 dígitos que da
// AdSense). Vacío ('' desde src/adSlots.ts, sin configurar) -> NO renderizamos
// unidad manual; Auto Ads coloca los anuncios. Esto evita <ins> rotos que no
// rinden. Para activar una unidad: pon su slot real en src/adSlots.ts.
const isRealSlot = /^\d{6,}$/.test(slot);
const renderUnit = active && isRealSlot;

const sizeByVariant: Record<string, string> = {
  horizontal: 'min-height:90px;',
  vertical:   'min-height:600px; max-width:300px; margin:0 auto;',
  square:     'min-height:250px; max-width:300px; margin:0 auto;',
  fluid:      'min-height:140px;',
};

const insStyle = `display:block; text-align:center; ${sizeByVariant[variant] || sizeByVariant.horizontal}`;
const loadingAttr = lazy ? 'lazy' : undefined;
---
{renderUnit ? (
  <aside class={`my-8 ${className}`} aria-label="Publicidad">
    <p class="text-[10px] uppercase tracking-widest text-ink-500 mb-1 text-center">Publicidad</p>
    <ins class="adsbygoogle block"
      style={insStyle}
      data-ad-client={ADSENSE}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"
      data-ad-layout={layout === 'in-article' ? 'in-article' : (layout === 'in-feed' ? 'in-feed' : undefined)}>
    </ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </aside>
) : (!active ? (
  <aside class={`my-8 ${className}`} aria-label="Publicidad">
    <div class={`border-2 border-dashed border-ink-300 rounded-lg p-6 text-center bg-ink-100/50 ${variant === 'vertical' ? 'min-h-[600px] max-w-[300px] mx-auto flex flex-col items-center justify-center' : variant === 'square' ? 'min-h-[250px] max-w-[300px] mx-auto' : ''}`}>
      <p class="text-xs uppercase tracking-widest text-ink-500 mb-1">Espacio reservado para publicidad</p>
      <p class="text-sm text-ink-700">AdSense aún no configurado (placeholder __PENDIENTE__).</p>
      <p class="text-[10px] text-ink-500 mt-2">variante: {variant}</p>
    </div>
  </aside>
) : null)}
