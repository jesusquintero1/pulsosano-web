---
export interface Props {
  slot?: string;
  format?: string;
  layout?: 'in-article' | 'display';
  className?: string;
}

const { slot = '', format = 'auto', layout = 'display', className = '' } = Astro.props;
const ADSENSE = import.meta.env.PUBLIC_ADSENSE_CLIENT || '';
const active = ADSENSE && !ADSENSE.includes('__PENDIENTE__');
---
<aside class={`my-8 ${className}`} aria-label="Publicidad">
  {active ? (
    <>
      <p class="text-[10px] uppercase tracking-widest text-ink-500 mb-1 text-center">Publicidad</p>
      <ins class="adsbygoogle block"
        style="display:block; text-align:center; min-height:90px;"
        data-ad-client={ADSENSE}
        data-ad-slot={slot}
        data-ad-format={format}
        data-full-width-responsive="true"
        data-ad-layout={layout === 'in-article' ? 'in-article' : undefined}>
      </ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </>
  ) : (
    <div class="border-2 border-dashed border-ink-300 rounded-lg p-6 text-center bg-ink-100/50">
      <p class="text-xs uppercase tracking-widest text-ink-500 mb-1">Espacio reservado para publicidad</p>
      <p class="text-sm text-ink-700">AdSense aún no configurado (placeholder __PENDIENTE__).</p>
    </div>
  )}
</aside>
