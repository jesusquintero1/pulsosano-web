---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  prevUrl?: string | null;
  nextUrl?: string | null;
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
}

const SITE_NAME = 'PulsoSano';
const SITE_TAGLINE = 'Noticias y avances en salud, basados en evidencia, en español.';
const SITE_URL = (import.meta.env.SITE_URL || Astro.site?.toString() || 'https://pulsosano.com').replace(/\/$/, '');
const ADSENSE = import.meta.env.PUBLIC_ADSENSE_CLIENT || 'ca-pub-__PENDIENTE__';
const adsenseActive = ADSENSE && !ADSENSE.includes('__PENDIENTE__');

const {
  title = SITE_NAME + ' — ' + SITE_TAGLINE,
  description = 'Resúmenes en español de las últimas noticias médicas y avances científicos, citando siempre la fuente original. Contenido informativo, no sustituye la consulta médica.',
  image,
  canonical,
  type = 'website',
  jsonLd,
  noindex = false,
  prevUrl,
  nextUrl,
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags,
} = Astro.props;

const url = canonical || new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = image || SITE_URL + '/og-default.png';
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: SITE_NAME,
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: SITE_URL + '/og-default.png',
    width: 1200,
    height: 630,
  },
  description: SITE_TAGLINE,
  inLanguage: 'es',
  knowsLanguage: ['es', 'en'],
  knowsAbout: [
    'Salud', 'Medicina', 'Investigación Clínica', 'Nutrición',
    'Salud Mental', 'Medicina Preventiva', 'Salud Pública',
  ],
  publishingPrinciples: SITE_URL + '/metodologia/',
  ethicsPolicy: SITE_URL + '/metodologia/#etica',
  diversityPolicy: SITE_URL + '/metodologia/#diversidad',
  correctionsPolicy: SITE_URL + '/metodologia/#correcciones',
  sameAs: [],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  inLanguage: 'es',
};

// hreflang LatAm: declaramos las variantes regionales del español
// apuntando a la misma URL — Google ranquea el contenido en cada país.
const HREFLANGS = [
  'es', 'es-MX', 'es-AR', 'es-CO', 'es-CL', 'es-PE', 'es-VE',
  'es-EC', 'es-GT', 'es-BO', 'es-DO', 'es-HN', 'es-PY', 'es-SV',
  'es-NI', 'es-CR', 'es-PA', 'es-UY', 'es-PR', 'es-ES', 'es-US',
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Robots: pide a Google snippets ilimitados y previews grandes — sube CTR en SERP */}
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    }
    {!noindex && <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
    {!noindex && <meta name="bingbot" content="index, follow" />}

    <link rel="canonical" href={url} />
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}

    {/* hreflang LatAm — la misma URL sirve a 21 variantes regionales del español */}
    {HREFLANGS.map((lang) => (
      <link rel="alternate" hreflang={lang} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={url} />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:locale:alternate" content="es_MX" />
    <meta property="og:locale:alternate" content="es_AR" />
    <meta property="og:locale:alternate" content="es_CO" />
    <meta property="og:locale:alternate" content="es_ES" />

    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
    {type === 'article' && articleTags && articleTags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}

    {/* Twitter / X Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    {/* Geo targeting — Latam priority */}
    <meta name="geo.region" content="MX" />
    <meta name="geo.placename" content="Latinoamérica" />

    {/* Favicon + PWA manifest */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo-square.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#10b981" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    {/* Discoverability: feeds para crawlers + lectores */}
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME + ' — RSS'} href={SITE_URL + '/rss.xml'} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/xml" title="Google News Sitemap" href={SITE_URL + '/news-sitemap.xml'} />

    {/* Performance: preconnect/preload críticos */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    {adsenseActive && (
      <>
        <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
        <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
        <link rel="dns-prefetch" href="https://googleads.g.doubleclick.net" />
      </>
    )}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+Pro:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    {adsenseActive && (
      <>
        <meta name="google-adsense-account" content={ADSENSE} />
        <script is:inline define:vars={{ ADSENSE }}>
          (function () {
            window.adsbygoogle = window.adsbygoogle || [];
            // Monetización: servir SIEMPRE (no pausar). Sin consentimiento explícito
            // se sirven anuncios NO personalizados (permitidos sin consent); al aceptar
            // en el banner se suben a personalizados. La audiencia es LatAm: gatear todo
            // tras un clic perdería la mayoría de las impresiones.
            // Nota EEA/UK: activar el mensaje de consentimiento GDPR en el dashboard de
            // AdSense (Privacidad y mensajes) para cumplimiento estricto en Europa.
            var npa = 1;
            try {
              if (localStorage.getItem('slm_consent') === 'accepted') npa = 0;
            } catch (e) {}
            window.adsbygoogle.requestNonPersonalizedAds = npa;
            window.adsbygoogle.pauseAdRequests = 0;
            // Auto Ads se activa por el parámetro ?client= del script (abajo). Repetir
            // enable_page_level_ads aquí duplicaba la inicialización y lanzaba error.
          })();
        </script>
        <script is:inline async src={'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + ADSENSE} crossorigin="anonymous"></script>
      </>
    )}

    {/* JSON-LD: Organization + WebSite (siempre) + el LD específico de la página */}
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {jsonLdArray.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

  </head>
  <body class="min-h-screen flex flex-col bg-white text-ink-900 antialiased">
    <Header />
    <main class="flex-1" id="contenido">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
