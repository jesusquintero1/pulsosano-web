---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const SITE_NAME = 'SaludLatAm';
const SITE_TAGLINE = 'Noticias y avances en salud, basados en evidencia, en español.';
const SITE_URL = (import.meta.env.SITE_URL || Astro.site?.toString() || 'https://saludlatam.com').replace(/\/$/, '');
const ADSENSE = import.meta.env.PUBLIC_ADSENSE_CLIENT || 'ca-pub-__PENDIENTE__';
const adsenseActive = ADSENSE && !ADSENSE.includes('__PENDIENTE__');

const {
  title = SITE_NAME + ' — ' + SITE_TAGLINE,
  description = 'Resúmenes en español de las últimas noticias médicas y avances científicos, citando siempre la fuente original. Contenido informativo, no sustituye la consulta médica.',
  image,
  canonical,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const url = canonical || new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = image || SITE_URL + '/og-default.png';
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  logo: SITE_URL + '/og-default.png',
  description: SITE_TAGLINE,
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_LA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME + ' RSS'} href={SITE_URL + '/rss.xml'} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+Pro:wght@600;700&display=swap" rel="stylesheet" />

    {adsenseActive && (
      <>
        <meta name="google-adsense-account" content={ADSENSE} />
        <script is:inline define:vars={{ ADSENSE }}>
          (function () {
            window.adsbygoogle = window.adsbygoogle || [];
            window.adsbygoogle.pauseAdRequests = 1;
            try {
              var consent = localStorage.getItem('slm_consent');
              if (consent === 'rejected') {
                window.adsbygoogle.requestNonPersonalizedAds = 1;
              }
            } catch (e) {}
          })();
        </script>
        <script is:inline async src={'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + ADSENSE} crossorigin="anonymous"></script>
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    {jsonLdArray.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-white text-ink-900 antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
