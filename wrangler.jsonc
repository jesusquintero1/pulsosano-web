{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saludlatam-web",
  "compatibility_date": "2026-05-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "saludlatam.com", "custom_domain": true },
    { "pattern": "www.saludlatam.com", "custom_domain": true }
  ]
}
